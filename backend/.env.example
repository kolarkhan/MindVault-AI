# ============================================================
# MindVault AI backend — environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ============================================================

# --- App ---
APP_NAME=MindVault AI
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Auth / JWT ---
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database (MongoDB Atlas) ---
# Create a free cluster at https://cloud.mongodb.com, then paste its connection string here.
# See README.md "Database setup" for how to also create the Atlas Vector Search index.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mindvault_ai
VECTOR_INDEX_NAME=memory_vector_index

# --- AI provider ---
# Leave OPENAI_API_KEY empty to run the AI layer in local mock mode (no external calls,
# deterministic placeholder output) — useful for development before you have a key.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=gpt-4o-mini

# --- Storage ---
# STORAGE_BACKEND=local uses backend/storage/uploads on disk (development).
# STORAGE_BACKEND=s3 requires the S3_* variables below (any S3-compatible provider).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=20

S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# --- CORS ---
CORS_ORIGINS=*
